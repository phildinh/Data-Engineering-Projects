),

joined_query as (
select
    sales.sales_id,
    sales.gross_amount,
    sales.payment_method,
    products.category,
    customers.gender
from sales 
join products 
    on sales.product_sk = products.product_sk
join customers 
    on sales.customer_sk = customers.customer_sk
)

select
    category,
    gender,
    SUM(gross_amount) as total_sales
from
    joined_query
group by
    category,
    gender
order by
    total_sales desc
  
